# Copy to .env and fill in. .env is git-ignored.

# Apidog On-Premises license token
APIDOG_LICENSE=
# Random string, e.g. openssl rand -hex 32
APIDOG_JWT_SECRET=

# Infisical: back these up, secrets cannot be decrypted without the encryption key
# openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=
# openssl rand -base64 32
INFISICAL_AUTH_SECRET=

# Redmine session signing key, e.g. openssl rand -hex 32
REDMINE_SECRET_KEY_BASE=

# Gitea runner registration token (Gitea UI: Site Administration > Actions > Runners)
GITEA_RUNNER_REGISTRATION_TOKEN=

# Service passwords (change from the defaults for anything beyond local dev)
# *_URLENCODED must be the same password, URL-encoded (@ -> %40, ! -> %21), used in Infisical connection URLs
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_URLENCODED=
REDIS_PASSWORD=
REDIS_PASSWORD_URLENCODED=
MYSQL_PASSWORD=
ORACLE_PASSWORD=
PGADMIN_PASSWORD=
RABBITMQ_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
MSSQL_PASSWORD=
APIDOG_ADMIN_PASSWORD=
